# Cache Control Headers for OnSeguros Website

# Security headers (on every response, errors included). No CSP/HSTS here:
# Cloudflare terminates TLS. Nothing on the site uses geolocation/camera/mic.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Branded 404 page (all its asset paths are absolute, so it works at any depth)
ErrorDocument 404 /404.html

# NO CACHE for config.json - always fetch fresh
<FilesMatch "config\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Moderate caching for JS/CSS files (1 hour) - short cache to allow quick updates
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# NO CACHE for HTML files - always check for updates
<FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Browser caching for images (30 days)
<FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# Self-hosted fonts (1 year) - never change in place, rename the file to update
<FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Rewrite rules for friendly URLs (if needed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>
